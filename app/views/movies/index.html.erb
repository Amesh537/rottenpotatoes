<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<h1>All Movies</h1>

<table>
  <thead>
    <tr>
      <th><%= link_to "Title", movies_path(sort: :title, direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
      <th><%= link_to "Rating", movies_path(sort: :rating, direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
      <th><%= link_to "Release Date", movies_path(sort: :release_date, direction: params[:direction] == "asc" ? "desc" : "asc") %></th>
      <th>More Info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date %></td>
        <td><%= link_to "Show", movie_path(movie) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="4"><%= pluralize(@movies.count, "movie") %> total</td>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path %>
